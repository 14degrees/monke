{
  "name": "monke",
  "version": "0.1.0",
  "description": "Exhaustive, sourced archive of monkey memes, videos, gifs and images + a grid browser",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",

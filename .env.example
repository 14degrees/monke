# Required for persistence. Without it the server runs read-only-ish from data/seed.json in memory.
MONGODB_URI=mongodb://user:pass@host:port
MONGODB_DB=monke
PORT=3000

# Optional source keys — each unlocks a scraper. Keyless sources run regardless.
YOUTUBE_API_KEY=        # console.cloud.google.com → YouTube Data API v3
GIPHY_API_KEY=          # developers.giphy.com
TENOR_API_KEY=          # Google Cloud → Tenor API
IMGUR_CLIENT_ID=        # api.imgur.com/oauth2/addclient
PIXABAY_API_KEY=        # pixabay.com/api/docs
PEXELS_API_KEY=         # pexels.com/api
REDDIT_CLIENT_ID=       # reddit.com/prefs/apps (script app) — avoids unauth JSON blocks
REDDIT_CLIENT_SECRET=

# Discovery agent — set ONE of these. Claude API uses server-side web_search/web_fetch;
# OpenRouter uses free DuckDuckGo/Bing search (Sonar fallback) + r.jina.ai page reader.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite   # any tool-calling model on OpenRouter
SEARCH_BACKEND=                                 # '' = ddg→bing→sonar, 'free' = never pay for search, 'sonar' = always Sonar
JINA_API_KEY=                                   # optional, raises r.jina.ai rate limits

# Hosting
ADMIN_TOKEN=          # required for scrape/agent/add buttons when set — set it on any public deploy
AUTO_SCRAPE_MIN=      # e.g. 360 → run keyless scrapers every 6h in-process
AUTO_DISCOVER_MIN=    # e.g. 120 → send the agent on a random brief every 2h (costs API credits)
